{
  "manifest_version": 3,
  "name": "日照房价探针 · 会话桥",
  "version": "1.0.0",
  "description": "你在 58/安居客网页上完成人机验证后，自动把会话同步到自己的房价探针站点，之后每天两次自动抓取并推送结果。",
  "permissions": ["cookies", "storage", "alarms"],
  "host_permissions": [
    "https://*.58.com/*",
    "https://*.anjuke.com/*",
    "https://*.ke.com/*",
    "https://rizhao-house-radar.app.workbuddy.host/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*.58.com/*ershoufang*", "https://*.58.com/*fangyuan*"],
      "js": ["content58.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html" },
  "options_page": "options.html"
}
