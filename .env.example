# ============================================================================
# 日照房价探针 · 捡漏雷达 —— 环境变量示例
# 用法：复制为 .env（与 README 同级），按需填值。全部留空也能正常启动。
# ============================================================================

# ---------- 数据库 ----------
# 默认 data/rizhao.db（SQLite），一般不用改
# RZ_DB_PATH=./data/rizhao.db

# ---------- 管理权限（网站只有你能改数据）----------
# 管理口令：留空则首次启动自动生成 16 位口令 → 存 app_setting + data/admin_token.txt
# 云托管建议在这里显式指定（优先级高于数据库里的自动生成值）
ADMIN_TOKEN=
# 0 = 关闭写操作鉴权（不推荐，仅本地调试用）
ADMIN_ENABLED=1

# ---------- 微信推送（优先级：群机器人 > 应用消息 > 公众号模板 > 站内降级）----------
# 【最推荐】企业微信群机器人：群设置 → 群机器人 → 添加 → 复制 Webhook 地址
# 形如 https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx
WECOM_WEBHOOK=

# 企业微信应用消息（可选）：企业微信管理后台 → 应用管理 → 自建应用
WECOM_CORP_ID=
WECOM_AGENT_SECRET=
WECOM_AGENT_ID=
WECOM_TO_USER=@all

# 微信公众号模板消息（可选）：需已认证服务号 + 模板消息权限 + 用户 openid
MP_APPID=
MP_SECRET=
MP_TEMPLATE_ID=
MP_OPENID=
# 模板字段顺序，按你申请的模板改；第一个放标题，最后一个是备注
MP_TEMPLATE_KEYS=first,keyword1,keyword2,keyword3,keyword4,remark

# 兜底通道（可选）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_TO=

# ---------- 抓取（默认关闭，先用演示数据把界面跑通）----------
# 打开前请确认目标站点 robots.txt 与使用条款，并保持 ≥3 秒间隔
CRAWL_ENABLED=0
CRAWL_MIN_INTERVAL=3
CRAWL_TIMEOUT=15

# ---------- 调度 ----------
ENABLE_SCHEDULER=1
DAILY_RUN_AT=02:30
TZ=Asia/Shanghai

# ---------- 前端 ----------
# 高德地图 Web端(JS API) Key，留空则地图页降级为坐标散点（不加载任何底图）
# 申请入口：https://console.amap.com → 应用管理 → 我的应用 → 添加 Key → 服务平台选「Web端(JS API)」
AMAP_KEY=
# JS API 2.0 安全密钥（jscode），与 Key 同页下方获取。2021-12 后申请的 Key 必填，否则报 INVALID_USER_SCODE
# 这两个值也可以在「管理台 → 地图底图配置」里在线填，保存即生效、不用重启
AMAP_SECURITY_CODE=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 评分模型可调参数 ----------
SCORE_MIN_SAMPLE=3        # 可比样本低于此值自动降置信度
DEEP_DIP_PCT=0.12         # 深跌阈值
SUDDEN_DROP_PCT=0.05      # 单次降价阈值
LONG_LISTED_DAYS=180      # 久挂阈值
AUCTION_NET_DISCOUNT=0.15 # 法拍净折扣阈值

# ---------- 购房成本与面积专题（前端「月供/现金门槛」「改善 120-150㎡」用）----------
DOWN_RATIO=0.30            # 首付比例（用户也可在偏好里改）
LOAN_YEARS=30              # 贷款年限
LOAN_RATE=0.031            # 年利率（首套商贷参考）
AGENT_FEE_RATIO=0.02       # 中介费比例
NEW_DECOR_COST=1200        # 毛坯装修成本（元/㎡），新房倒挂调整用
TARGET_AREA_MIN=120        # 关注面积段下限
TARGET_AREA_MAX=150        # 关注面积段上限

# ---------- 新房倒挂口径 ----------
# 得房率参考（建筑面积 → 套内面积）：新盘公摊大，二手略高
# 修改后重启生效；只影响「调整后倒挂」的计算
# NEW_EFFICIENCY=0.78
# USED_EFFICIENCY=0.82
